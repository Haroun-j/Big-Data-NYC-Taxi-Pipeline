# Copy this file to .env and fill in the values. docker compose reads .env
# automatically; export the same variables in your shell before running the
# Scala jobs or the Python scripts outside Docker.

COMPOSE_PROJECT_NAME=nyc-taxi

# Absolute path of this repository on the Docker host. The Airflow DAG mounts
# it into the containers it starts.
PROJECT_DIR=/home/you/Big-Data-NYC-Taxi-Pipeline

# MinIO (S3 API on 9000, console on 9001). Password must be 8+ characters.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
# Endpoint as seen from where you run the jobs (localhost from the host,
# http://minio:9000 from inside the compose network).
MINIO_ENDPOINT=http://localhost:9000
RAW_BUCKET=nyc-raw
VALIDATED_BUCKET=nyc-validated
YEAR=2023

# Warehouse
POSTGRES_DB=taxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Airflow metadata database and web login
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Optional. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
